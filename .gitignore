# SofreDoc Validator — gitignore raíz

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml

# Backend runtime (SQLite — efímero; WAL genera los sidecars -shm/-wal)
backend/data/sofredoc.db
backend/data/sofredoc.db-shm
backend/data/sofredoc.db-wal

# Node / Frontend
node_modules/
dist/

# QA artifacts (Playwright / k6)
qa/artifacts/
test-results/

# Entorno con secretos — nunca en el repo (los .env.example sí se versionan)
.env
backend/.env
frontend/.env
