# SofreDoc Validator — gitignore raíz

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml

# Backend runtime (SQLite — efímero; WAL genera los sidecars -shm/-wal)
backend/data/sofredoc.db
backend/data/sofredoc.db-shm
backend/data/sofredoc.db-wal

# Node / Frontend
node_modules/
dist/

# QA artifacts (Playwright / k6)
qa/artifacts/
test-results/

# Entorno con secretos — nunca en el repo (los .env.example sí se versionan)
.env
backend/.env
frontend/.env

# PDFs de prueba reales en la raíz (smoke manual con LLM real — ADR-02-10/11/12):
# se ignoran para que no viajen con el repo; los ejemplos y fixtures versionados
# viven en backend/data/ejemplos/ y qa/e2e/fixtures/
/*.pdf

# Dossier ejecutivo de presentación — pieza privada, fuera del repo público
PRESENTACION_SOFREDOC.md
