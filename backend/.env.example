# SofreDoc Validator — variables de entorno del backend
# Copiar a `.env` y ajustar. El `.env` real NO se versiona (está en .gitignore).

APP_ENV=dev
API_PORT=8000
# Orígenes CORS separados por coma (en prod: dominio de Vercel — MOD-05 §5)
CORS_ORIGINS=http://localhost:5173
DB_PATH=backend/data/sofredoc.db

# mock | llm  (llm requiere LLM_API_KEY)
EXTRACTOR_MODE=mock
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

PADRON_PATH=backend/data/proveedores.json
MAX_PDF_MB=5
TZ=America/Argentina/Buenos_Aires
